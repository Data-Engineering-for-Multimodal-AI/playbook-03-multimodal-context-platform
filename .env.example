# Google Cloud mode only. Local mode (--local) needs none of these.
# Copy to .env, fill in, then: set -a; source .env; set +a
# The scripts read these as defaults; the printed --project/--bucket/--endpoint flags still work.

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET=your-bucket-name

# Document AI processors (Console > Document AI > Processors). Location: us or eu.
DOCAI_LOCATION=us
DOCAI_DRIVER_LICENSE_PROCESSOR_ID=
DOCAI_W2_PROCESSOR_ID=
DOCAI_FORM_PROCESSOR_ID=
DOCAI_BANK_STATEMENT_PROCESSOR_ID=

# Embedding model. Google retires text-embedding-005 on April 1, 2027; then set its
# replacement here (for example gemini-embedding-001) and rerun create_embeddings.py
# and setup_vector_search.py. The index keeps EMBEDDING_DIMENSIONS.
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSIONS=768

# Printed by setup_vector_search.py ("Endpoint ID: projects/.../indexEndpoints/...")
VECTOR_SEARCH_ENDPOINT=

# Authentication: gcloud auth application-default login
# (or GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json; never commit that file)
